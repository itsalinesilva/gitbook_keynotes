{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/brain-os/evaluation-result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "suite_version",
    "subject_version",
    "decision",
    "checks"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string"
    },
    "suite_version": {
      "type": "string"
    },
    "subject_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "pass",
        "pass_with_conditions",
        "fail",
        "inconclusive"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "inconclusive"
            ]
          },
          "observed": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}