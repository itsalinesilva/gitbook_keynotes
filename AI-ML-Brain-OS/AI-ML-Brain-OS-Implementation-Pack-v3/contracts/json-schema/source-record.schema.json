{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/brain-os/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "canonical_url",
    "source_type",
    "title",
    "first_seen_at",
    "last_verified_at",
    "verification_status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "source_type": {
      "enum": [
        "primary",
        "academic",
        "official_documentation",
        "journalism",
        "industry_analysis",
        "community",
        "social",
        "dataset",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_status": {
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "unavailable",
        "retired"
      ]
    },
    "topic_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reliability_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}