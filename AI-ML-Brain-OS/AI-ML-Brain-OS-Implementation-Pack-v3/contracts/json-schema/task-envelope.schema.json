{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/brain-os/task-envelope.schema.json",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "correlation_id",
    "actor_id",
    "objective",
    "acceptance_criteria",
    "risk_class",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_class": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      },
      "required": [
        "data_classification"
      ],
      "additionalProperties": false
    },
    "requested_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval_required": {
      "type": "boolean"
    }
  }
}